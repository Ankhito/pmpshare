{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pmpshare-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-22",
  "r2_buckets": [
    {
      "binding": "PMP_BUCKET",
      "bucket_name": "pmpshare-mvp",
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
}
